{
  "name": "bzm-playwright-vitals-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run build:browser --workspace packages/dashboard && tsc --build",
    "test": "npm run test --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version && node .changeset/sync-dashboard-version.mjs && npm install --package-lock-only --ignore-scripts --no-audit --no-fund"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "^5.0.1"
  }
}
