# BlazeMeter API credentials — never commit
api-key.json
api-keys.json

# macOS
.DS_Store

# Node
node_modules/
dist/

# Fetched artifact cache — re-fetchable from the API, never committed
.artifact-cache/

# Playwright run output (Seam 1 harness scratch)
test-results/
playwright-report/

# Generated dashboard reports (rendered from a master id; re-generable, never committed)
validation-*.html
report*.html

# Standalone collector build artifact (generated by build-standalone.ts; the copies in
# upload-kit/ and test/fixtures/ are placed there by the script/harness respectively)
dist-standalone/
packages/collector/upload-kit/bzm-playwright-vitals.ts
packages/collector/test/fixtures/bzm-playwright-vitals.ts

# Throwaway live-Engine acceptance kit (scaffolded on demand; upload-only, never committed)
packages/collector/acceptance-kit/

*.tsbuildinfo
