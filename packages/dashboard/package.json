{
  "name": "bzm-vitals-dashboard",
  "version": "0.5.0",
  "description": "Dashboard generator — point it at a BlazeMeter master id, get one self-contained static HTML file with the data baked in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjithompson/blazemeter-web-vitals-report.git",
    "directory": "packages/dashboard"
  },
  "keywords": [
    "blazemeter",
    "web-vitals",
    "core-web-vitals",
    "dashboard",
    "report",
    "performance",
    "playwright"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bzm-vitals-dashboard": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run build:browser && tsc --build",
    "build:browser": "tsx scripts/build-browser.ts",
    "build:standalone": "tsx scripts/build-standalone.ts",
    "typecheck": "npm run build:browser && tsc --build",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "bzm-vitals-format": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4"
  }
}
