{
  "name": "bzm-vitals-dashboard",
  "version": "0.1.1",
  "description": "Dashboard generator — point it at a BlazeMeter master id, get one self-contained static HTML file with the data baked in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjithompson/BlazeMeterPlaywrightReporting.git",
    "directory": "packages/dashboard"
  },
  "keywords": [
    "blazemeter",
    "web-vitals",
    "core-web-vitals",
    "dashboard",
    "report",
    "performance",
    "playwright"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bzm-vitals-dashboard": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "bzm-vitals-format": "0.1.0",
    "yauzl": "^3.1.0"
  },
  "devDependencies": {
    "@types/yauzl": "^2.10.0"
  }
}
